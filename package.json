{
  "name": "supportflow",
  "version": "0.1.0",
  "private": true,
  "description": "SupportFlow - Customer support operations platform for small SaaS companies",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "test": "npm run test --workspace=backend",
    "test:e2e": "playwright test",
    "seed": "npm run seed --workspace=backend",
    "db:clean": "npm run db:clean --workspace=backend",
    "init:admin": "npm run init:admin --workspace=backend",
    "typecheck": "npm run typecheck --workspace=backend && npm run typecheck --workspace=frontend",
    "lint": "npm run lint --workspace=backend && npm run lint --workspace=frontend",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "keywords": [
    "support-flow",
    "ticketing",
    "saas",
    "customer-support"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.2.5"
  }
}
