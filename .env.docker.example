# ==============================================================================
# SupportFlow Docker Environment Configuration (.env.docker.example)
# Copy this file to .env in the project root if you wish to override defaults:
# cp .env.docker.example .env
# ==============================================================================

# Port Mappings
FRONTEND_PORT=80
BACKEND_PORT=5000
MONGO_PORT=27017
REDIS_PORT=6379

# Network URL where frontend connects to API (default reverse proxy via Nginx port 80)
CLIENT_URL=http://localhost

# Database Connection (Defaults to local Docker 'mongo' service)
# To use MongoDB Atlas, uncomment and replace with your connection string:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/supportflow?retryWrites=true&w=majority
MONGODB_URI=mongodb://mongo:27017/supportflow

# Redis URL (Defaults to local Docker 'redis' service)
REDIS_URL=redis://redis:6379

# Production Security Tokens (MUST be at least 32 characters in production)
JWT_SECRET=supportflow_production_jwt_secret_key_minimum_32_chars
JWT_REFRESH_SECRET=supportflow_production_jwt_refresh_secret_minimum_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File Storage Configuration
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=uploads
LOG_LEVEL=info
