# ==============================================================================
# SupportFlow Root Environment Variables Reference
# ==============================================================================

# Backend API Configuration (set inside backend/.env)
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/supportflow?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173
JWT_SECRET=supportflow_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=supportflow_super_secret_jwt_refresh_key_2026_change_in_production
JWT_REFRESH_EXPIRES_IN=7d
REDIS_URL=
LOG_LEVEL=info
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=uploads

# Frontend Configuration (optional: vite defaults to proxy /api to port 5000)
# VITE_API_URL=http://localhost:5000
