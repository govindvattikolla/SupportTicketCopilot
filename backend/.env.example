# ==============================================================================
# SupportFlow Backend Environment Variables (.env.example)
# Copy this file to .env and configure values for your environment.
# NEVER commit your production .env with real credentials into source control.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development # 'development' | 'production' | 'test'

# Database Configuration
# Production: MongoDB Atlas Cluster URI or self-hosted replica set
# Local Fallback: mongodb://127.0.0.1:27017/supportflow
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/supportflow?retryWrites=true&w=majority

# Client Application URL (used for CORS and origin validation)
CLIENT_URL=http://localhost:5173

# Authentication & Security
# WARNING: In production, generate secure random 64-character hex keys:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=supportflow_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=supportflow_super_secret_jwt_refresh_key_2026_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Background Worker & Distributed Cache (Redis)
# Optional in development (defaults to thread-safe in-memory queue fallback)
# Required in multi-replica production:
# REDIS_URL=redis://default:<password>@<redis-host>:6379
REDIS_URL=

# Structured Logging Configuration
# Levels: 'debug' | 'info' | 'warn' | 'error'
# In production, outputs structured JSON format for CloudWatch/Datadog/Loki
LOG_LEVEL=info

# Attachment Storage Configuration
# 'local' writes to server filesystem (STORAGE_LOCAL_PATH)
# 's3' connects to AWS S3, Cloudflare R2, or MinIO
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=uploads

# S3-Compatible Object Storage (Only if STORAGE_DRIVER=s3)
# S3_BUCKET=supportflow-attachments
# S3_REGION=us-east-1
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=<your_access_key>
# AWS_SECRET_ACCESS_KEY=<your_secret_key>
